{
  "name": "unissh-server-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "UniSSH Server — self-hosted zero-knowledge admin panel (React + Vite SPA)",
  "scripts": {
    "dev": "vite",
    "build:wasm": "cd crypto-wasm && wasm-pack build --target web --out-dir pkg --release",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "i18next": "^26.4.0",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^6",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
